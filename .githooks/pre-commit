#!/bin/sh
# Regenerate RE-progress numbers and include them in this commit.
# Enable once per clone: git config core.hooksPath .githooks
if command -v pwsh >/dev/null 2>&1; then ps=pwsh; else ps=powershell.exe; fi
changed=$("$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/progress.ps1) || {
    echo "pre-commit: scripts/progress.ps1 failed" >&2
    exit 1
}
for file in $changed; do
    git add -- "$file"
done
